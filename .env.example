# Copier ce fichier en .env.local et compléter les valeurs (Étape 2).
# Ne jamais committer .env.local.

# URL publique du site (sert aux liens de vérification des QR codes)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase — clés publiques (soumises aux règles RLS)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase — clé secrète, utilisée UNIQUEMENT côté serveur
SUPABASE_SERVICE_ROLE_KEY=
